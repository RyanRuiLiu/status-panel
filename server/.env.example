# 复制为 .env 并填入实际值（.env 不入库）

# CAS 统一身份认证（电量抓取用真实账号；密码错误 5 次会锁号，勿试错）
CAS_USERNAME=""
CAS_PASSWORD=""

# 企业微信群机器人（完整 URL 或纯 key 均可；留空 = 禁用告警）
WECOM_WEBHOOK_KEY=""

# ---- 抓取房间（单房间，必填）----
NTU_XIAOQU_ID=
NTU_LOUDONG_ID=
NTU_ROOM_ID=

# ---- 浴室（ntu-shower 服务端，必填）----
SHOWER_BASE_URL=""
SHOWER_DEVICE_ID=""
